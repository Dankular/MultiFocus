<Window x:Class="PhantomPlayGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhantomPlayGUI"
        mc:Ignorable="d"
        Title="PhantomPlay" Height="560" Width="820" MinWidth="640" MinHeight="480"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource WindowFg}"
        Loaded="Window_Loaded" StateChanged="Window_StateChanged" Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="150"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Available processes -->
        <GroupBox Grid.Row="0" Header="Available processes" Margin="5">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" x:Name="SearchBox" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged">
                            <TextBox.ToolTip>
                                <ToolTip>Filter the list by window title or executable name</ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="Processes" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                             MouseDoubleClick="Inject"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="8,22,0,0">
                    <Button Content="Inject" Margin="0,0,0,6" Padding="4" Click="Inject">
                        <Button.ToolTip>
                            <ToolTip>Inject PhantomPlay into the selected process (double-click also works)</ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button Content="Refresh" Margin="0,0,0,6" Padding="4" Click="Refresh">
                        <Button.ToolTip>
                            <ToolTip>Refresh the process list</ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button Content="Save preset" Padding="4" Click="AddPreset">
                        <Button.ToolTip>
                            <ToolTip>Save the selected process's executable as an auto-inject preset</ToolTip>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Injected processes -->
        <GroupBox Grid.Row="1" Header="Injected" Margin="5">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <ListBox Grid.Column="0" x:Name="InjectedProcesses" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Button Content="Unload" Padding="4" Click="Unload">
                        <Button.ToolTip>
                            <ToolTip>Unload PhantomPlay from the selected process</ToolTip>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Auto-inject presets -->
        <GroupBox Grid.Row="2" Header="Auto-inject presets" Margin="5">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <ListBox Grid.Column="0" x:Name="PresetsList" Height="90" HorizontalAlignment="Stretch"/>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <CheckBox x:Name="AutoInjectCheck" Content="Enable auto-inject" Margin="0,0,0,6"
                              Checked="AutoInjectCheck_Changed" Unchecked="AutoInjectCheck_Changed">
                        <CheckBox.ToolTip>
                            <ToolTip>Automatically inject into preset games as soon as they launch</ToolTip>
                        </CheckBox.ToolTip>
                    </CheckBox>
                    <CheckBox x:Name="MinimizeTrayCheck" Content="Minimize to tray" Margin="0,0,0,8"
                              Checked="MinimizeTrayCheck_Changed" Unchecked="MinimizeTrayCheck_Changed">
                        <CheckBox.ToolTip>
                            <ToolTip>Hide the window to the system tray when minimized</ToolTip>
                        </CheckBox.ToolTip>
                    </CheckBox>
                    <Button Content="Remove preset" Padding="4" Click="RemovePreset">
                        <Button.ToolTip>
                            <ToolTip>Remove the selected preset</ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="ThemeButton" Content="Theme: Light" Padding="4" Margin="0,10,0,0" Click="ThemeButton_Click">
                        <Button.ToolTip>
                            <ToolTip>Switch between light and dark theme</ToolTip>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
